# Optional local secrets for ctxgit.
# Copy this file to `.env` in this repository and fill values locally.
# `.env` is ignored by Git and should not be committed.

BRAVE_API_KEY=

# Optional Codex CLI override. Usually not needed on Windows because ctxgit
# falls back to the Codex binary bundled with the VS Code/Cursor ChatGPT extension.
# CTXGIT_CODEX_BIN=C:\Users\you\.vscode\extensions\openai.chatgpt-...\bin\windows-x86_64\codex.exe

# Optional defaults for scripts/windows/start-ctxgit.ps1 and scripts/macos/start-ctxgit.sh.
# Leave CTXGIT_ROOT unset to start the browser UI with no project selected.
# CTXGIT_ROOT=/absolute/path/to/your/ctxgit/project
# CTXGIT_HOST=127.0.0.1
# CTXGIT_PORT=8766
