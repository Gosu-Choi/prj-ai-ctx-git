# Slack browser session credentials. Copy to `.env` in this directory.
# Both are required; without them the Slack server is not offered at all.
SLACK_MCP_XOXC_TOKEN=xoxc-...
SLACK_MCP_XOXD_TOKEN=xoxd-...

# Posting is off by default. Uncomment to allow it — `true` for every channel,
# or a comma-separated list of channel IDs to limit it to those.
# SLACK_MCP_ADD_MESSAGE_TOOL=C0123456789,C0987654321
